# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# données locales (base SQLite + médias uploadés)
/data/

# configuration et marque perso (modèles : workspaces.example.json, brand/EXEMPLE.md)
/workspaces.json
/brand/*
!/brand/README.md
!/brand/EXEMPLE.md
!/brand/skills/

# notes de travail perso
/docs/*.md

# réglages locaux de Claude Code
/.claude/
